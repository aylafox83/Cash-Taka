<!doctype html>
<html lang="bn"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<script src="https://telegram.org/js/telegram-web-app.js"></script>

<!-- 🔥 Firebase SDKs CDN (কোড পরিবর্তন না করে ফায়ারবেস যুক্ত করার জন্য) -->
<script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"></script>
<script>
  // আপনার Firebase কনফিগারেশন এখানে বসান (Firebase Console থেকে পাবেন)
  const firebaseConfig = {
    apiKey: "YOUR_API_KEY",
    authDomain: "YOUR_PROJECT_ID.firebaseapp.com",
    projectId: "YOUR_PROJECT_ID",
    storageBucket: "YOUR_PROJECT_ID.appspot.com",
    messagingSenderId: "YOUR_SENDER_ID",
    appId: "YOUR_APP_ID"
  };
  firebase.initializeApp(firebaseConfig);
  const db = firebase.firestore();
</script>

<title>TaskBot — User Panel</title>
<style>
:root{--bg:#eef2f7;--card:#fff;--ink:#0f172a;--mut:#64748b;--line:#e2e8f0;--pri:#2563eb;--pri2:#7c3aed;--ok:#16a34a;--bad:#dc2626;--warn:#d97706}
*{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--ink)}
.top{background:linear-gradient(135deg,#2563eb,#7c3aed);color:#fff;padding:18px 16px 22px;border-radius:0 0 22px 22px}
.top h1{margin:0;font-size:22px}.top p{margin:4px 0 0;opacity:.85;font-size:13px}
.wrap{max-width:760px;margin:-12px auto 0;padding:0 14px 28px}
.bal{background:var(--card);border-radius:18px;padding:18px;box-shadow:0 8px 24px #0f172a14;display:flex;justify-content:space-between;gap:12px;align-items:center}
.bal small{color:var(--mut)}.bal b{font-size:30px;display:block}
.btn{border:0;border-radius:10px;padding:11px 16px;font-weight:700;cursor:pointer;background:var(--pri);color:#fff}
.btn.secondary{background:#eef2ff;color:var(--pri)}.btn.ghost{background:#f1f5f9;color:var(--ink)}
.btn:disabled{opacity:.6}
.tabs{display:flex;gap:8px;margin:16px 0}.tab{flex:1;border:0;border-radius:12px;padding:11px;background:#fff;cursor:pointer;font-weight:700;color:var(--mut);box-shadow:0 1px 4px #0001}
.tab.active{background:var(--ink);color:#fff}
.card{background:var(--card);border-radius:16px;padding:16px;margin:12px 0;box-shadow:0 2px 10px #0f172a0d}
.row{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}
.pill{display:inline-block;padding:3px 9px;border-radius:20px;font-size:12px;font-weight:700;background:#e0e7ff;color:#3730a3}
.reward{background:#dcfce7;color:#166534;font-size:14px;padding:5px 10px;border-radius:20px;font-weight:800;white-space:nowrap}
.steps{white-space:pre-wrap;background:#f8fafc;border:1px solid var(--line);border-radius:10px;padding:10px;font-size:13px;color:#334155}
input,select,textarea{width:100%;padding:11px;margin:7px 0;border:1px solid var(--line);border-radius:10px;font-size:15px}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}.chip{border:1px solid var(--line);background:#fff;border-radius:20px;padding:7px 12px;cursor:pointer;font-size:13px}
.chip.active{background:var(--pri);color:#fff;border-color:var(--pri)}
.badge{padding:4px 9px;border-radius:20px;font-size:12px;font-weight:800}.pending{background:#fef3c7;color:#92400e}.approved,.paid{background:#dcfce7;color:#166534}.rejected{background:#fee2e2;color:#991b1b}
.mut{color:var(--mut);font-size:13px}.empty{text-align:center;color:var(--mut);padding:28px 10px}
.proof{display:none;margin-top:12px;border-top:1px dashed var(--line);padding-top:12px}.proof.open{display:block}
.preview{max-width:100%;border-radius:10px;margin-top:8px;display:none}
#toast{position:fixed;left:50%;bottom:20px;transform:translateX(-50%);background:#0f172a;color:#fff;padding:12px 18px;border-radius:12px;display:none;z-index:50;max-width:90%;text-align:center}
a{color:var(--pri)}
</style></head>
<body>
<div class="top"><h1>💰 TaskBot</h1><p>Kaj koro • Prove dao • Approve holei taka</p></div>
<div class="wrap">
  <div class="bal"><div><small>Available Balance</small><b id="bal">0 ৳</b><span class="mut" id="who"></span></div>
  <div style="text-align:right"><small>Total Earned</small><b id="earned" style="font-size:20px;color:var(--ok)">0 ৳</b><div class="mut" id="pendingCount"></div></div></div>

  <div class="tabs">
    <button class="tab active" onclick="showTab('tasks',this)">📋 Tasks</button>
    <button class="tab" onclick="showTab('mine',this)">🔥 Amar Kaj</button>
    <button class="tab" onclick="showTab('withdraw',this)">💸 Withdraw</button>
  </div>

  <div id="sec-tasks">
    <input id="search" placeholder="🔍 Task khujo..." oninput="renderTasks()">
    <div class="chips" id="chips"></div>
    <div id="tasks"></div>
  </div>

  <div id="sec-mine" style="display:none"><div id="mine"></div></div>

  <div id="sec-withdraw" style="display:none">
    <div class="card"><h3 style="margin-top:0">💸 Withdraw Request</h3>
      <p class="mut" id="wdNote"></p>
      <label class="mut">Method</label><select id="wdMethod"><option>bKash</option><option>Nagad</option><option>Rocket</option></select>
      <label class="mut">Mobile Number</label><input id="wdAccount" placeholder="01XXXXXXXXX" inputmode="numeric">
      <label class="mut">Amount (৳)</label><input id="wdAmount" type="number" placeholder="Amount">
      <button class="btn" style="width:100%" onclick="submitWithdraw()">Withdraw Request Pathao</button>
      <p class="mut">Request korlei taka balance theke hold hobe. Admin payment pathale status Paid hobe, reject hole taka ferot asbe.</p>
    </div>
    <h3>Withdraw History</h3><div id="wdList"></div>
  </div>
</div>
<div id="toast"></div>
<script>
const tg = window.Telegram?.WebApp; tg?.expand();
const user = tg?.initDataUnsafe?.user;
const tgid = user?.id || new URLSearchParams(location.search).get('tgid') || 'demo123';
const username = user?.username || 'demo_user';

// 🔄 আপনার আসল কোডের API কলগুলোকে ফায়ারবেস ডাটাবেজের সাথে সরাসরি কানেক্ট করার জন্য ফেক API ইন্টারসেপ্টর
window.fetch = async function(url, opt = {}) {
  const method = opt.method || 'GET';
  const body = opt.body ? JSON.parse(opt.body) : {};

  try {
    if (url === '/api/register' && method === 'POST') {
      const userRef = db.collection('users').doc(String(body.tgid || tgid));
      const doc = await userRef.get();
      if (!doc.exists) {
        await userRef.set({ tgid: String(body.tgid || tgid), username: body.username || username, name: body.name || 'Demo', balance: 0 });
      }
      return { json: async () => ({ success: true }) };
    }

    if (url.startsWith('/api/me')) {
      const userDoc = await db.collection('users').doc(String(tgid)).get();
      const subSnap = await db.collection('submissions').where('tgid', '==', String(tgid)).get();
      const wdSnap = await db.collection('withdrawals').where('tgid', '==', String(tgid)).get();
      const stDoc = await db.collection('settings').doc('general').get();
      
      return {
        json: async () => ({
          user: userDoc.exists ? userDoc.data() : { balance: 0 },
          submissions: subSnap.docs.map(d => ({ id: d.id, ...d.data() })),
          withdrawals: wdSnap.docs.map(d => ({ id: d.id, ...d.data() })),
          minWithdraw: stDoc.exists ? (stDoc.data().minWithdraw || 100) : 100
        })
      };
    }

    if (url === '/api/tasks' && method === 'GET') {
      const taskSnap = await db.collection('tasks').get();
      return { json: async () => ({ tasks: taskSnap.docs.map(d => ({ id: d.id, ...d.data() })) }) };
    }

    if (url === '/api/submissions' && method === 'POST') {
      const taskDoc = await db.collection('tasks').doc(String(body.taskId)).get();
      const task = taskDoc.exists ? taskDoc.data() : { title: 'Task', reward: 0 };
      await db.collection('submissions').add({
        tgid: String(tgid), username: username, taskId: String(body.taskId),
        taskTitle: task.title, reward: task.reward, proofText: body.proofText,
        proofImage: body.proofImage || '', status: 'pending', createdAt: new Date().toISOString()
      });
      return { json: async () => ({ success: true }) };
    }

    if (url === '/api/withdrawals' && method === 'POST') {
      const numAmount = Number(body.amount);
      const userRef = db.collection('users').doc(String(tgid));
      const userDoc = await userRef.get();
      const userData = userDoc.data() || { balance: 0 };

      if (userData.balance < numAmount) {
        return { json: async () => ({ error: 'Available balance is not enough' }) };
      }

      await userRef.update({ balance: firebase.firestore.FieldValue.increment(-numAmount) });
      await db.collection('withdrawals').add({
        tgid: String(tgid), username: username, method: body.method,
        account: body.account, amount: numAmount, status: 'pending', createdAt: new Date().toISOString()
      });
      return { json: async () => ({ success: true }) };
    }

    return { json: async () => ({ error: 'Not found' }) };
  } catch (err) {
    return { json: async () => ({ error: err.message }) };
  }
};

const headers = {'Content-Type':'application/json','x-telegram-id':tgid};
let allTasks=[], mine=[], wds=[], minWithdraw=100, filter='all';
const TYPE_LABEL={account_create:'Account Create',app_install:'App Install',follow:'Follow / Join',review:'Review',general:'Onno'};
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function toast(m){const t=document.getElementById('toast');t.textContent=m;t.style.display='block';setTimeout(()=>t.style.display='none',3200)}
async function api(p,opt={}){const r=await fetch(p,{...opt,headers});return r.json()}
function showTab(id,btn){document.querySelectorAll('.tab').forEach(b=>b.classList.remove('active'));btn.classList.add('active');
  ['tasks','mine','withdraw'].forEach(s=>document.getElementById('sec-'+s).style.display=(s===id?'block':'none'))}
function setFilter(f,el){filter=f;document.querySelectorAll('.chip').forEach(c=>c.classList.remove('active'));el.classList.add('active');renderTasks()}
function renderChips(){const types=['all',...new Set(allTasks.map(t=>t.type))];
  document.getElementById('chips').innerHTML=types.map(t=>`<button class="chip ${t===filter?'active':''}" onclick="setFilter('${t}',this)">${t==='all'?'Sob':(TYPE_LABEL[t]||t)}</button>`).join('')}
function renderTasks(){const q=(document.getElementById('search').value||'').toLowerCase();
  const list=allTasks.filter(t=>(filter==='all'||t.type===filter)&&t.title.toLowerCase().includes(q));
  document.getElementById('tasks').innerHTML=list.map(t=>`<div class="card"><div class="row"><div><b>${esc(t.title)}</b><br><span class="pill">${TYPE_LABEL[t.type]||esc(t.type)}</span></div><span class="reward">+${t.reward} ৳</span></div>
  <div class="steps">${esc(t.steps||'Nirdeshona deoa nai.')}</div>
  ${t.link?`<p><a href="${esc(t.link)}" target="_blank" rel="noopener">🔗 Task Link Kholo</a></p>`:''}
  <button class="btn secondary" onclick="document.getElementById('form${t.id}').classList.toggle('open')">✍️ Prove Joma Dao</button>
  <div class="proof" id="form${t.id}">
    <input id="p${t.id}" placeholder="Prove: je account / email / username use korecho">
    <input type="file" id="f${t.id}" accept="image/*" onchange="previewImg(${t.id},this)">
    <img id="img${t.id}" class="preview">
    <button class="btn" style="width:100%" onclick="submitProof(${t.id},this)">✅ Submit Prove</button>
  </div></div>`).join('')||'<div class="card empty">Ekhono kono task nai. Pore abar check koro.</div>'}
function previewImg(id,input){const f=input.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{const im=document.getElementById('img'+id);im.src=r.result;im.style.display='block'};r.readAsDataURL(f)}
function renderMine(){const earned=mine.filter(s=>s.status==='approved').reduce((a,s)=>a+s.reward,0);
  document.getElementById('earned').textContent=earned+' ৳';
  document.getElementById('pendingCount').textContent=mine.filter(s=>s.status==='pending').length+' ta pending';
  document.getElementById('mine').innerHTML=mine.slice().reverse().map(s=>`<div class="card"><div class="row"><b>${esc(s.taskTitle)}</b><span class="badge ${s.status}">${s.status}</span></div><p class="mut">${s.reward} ৳ ${s.reason?'• Karon: '+esc(s.reason):''}</p></div>`).join('')||'<div class="card empty">Ekhono kono kaj joma dao nai.</div>'}
function renderWd(){document.getElementById('wdNote').textContent='Minimum withdraw: '+minWithdraw+' ৳ • Available: '+(document.getElementById('bal').dataset.v||0)+' ৳';
  document.getElementById('wdList').innerHTML=wds.slice().reverse().map(w=>`<div class="card"><div class="row"><b>${esc(w.method)} — ${esc(w.account)}</b><span class="badge ${w.status}">${w.status}</span></div><p class="mut">${w.amount} ৳ ${w.reason?'• Karon: '+esc(w.reason):''} • ${new Date(w.createdAt).toLocaleString('bn-BD')}</p></div>`).join('')||'<div class="card empty">Ekhono kono withdraw request nai.</div>'}
async function submitProof(id,btn){const proofText=document.getElementById('p'+id).value.trim();
  if(!proofText)return toast('Prove text dao — je account/email use korecho');
  const file=document.getElementById('f'+id).files[0];let proofImage='';
  if(file)proofImage=await new Promise(res=>{const r=new FileReader();r.onload=()=>res(r.result);r.readAsDataURL(file)});
  btn.disabled=true;const d=await api('/api/submissions',{method:'POST',body:JSON.stringify({tgid,username,taskId:id,proofText,proofImage})});btn.disabled=false;
  if(d.error)toast(d.error);else{toast('Prove joma hoyeche! Admin approve korle taka add hobe.');await init();showTab('mine',document.querySelectorAll('.tab')[1])}}
async function submitWithdraw(){const method=document.getElementById('wdMethod').value,account=document.getElementById('wdAccount').value.trim(),amount=document.getElementById('wdAmount').value;
  const d=await api('/api/withdrawals',{method:'POST',body:JSON.stringify({tgid,username,method,account,amount})});
  if(d.error)toast(d.error);else{toast('Withdraw request pathano hoyeche. Admin payment pathabe.');document.getElementById('wdAmount').value='';await init()}}
async function init(){await api('/api/register',{method:'POST',body:JSON.stringify({tgid,username,name:user?.first_name||'Demo'})});
  const me=await api('/api/me?tgid='+tgid);mine=me.submissions||[];wds=me.withdrawals||[];minWithdraw=me.minWithdraw||100;
  const bal=me.user?.balance||0;document.getElementById('bal').textContent=bal+' ৳';document.getElementById('bal').dataset.v=bal;
  document.getElementById('who').textContent='@'+(me.user?.username||'')+' • ID: '+tgid;
  const d=await api('/api/tasks');allTasks=d.tasks||[];renderChips();renderTasks();renderMine();renderWd()}
init();
</script></body></html>
